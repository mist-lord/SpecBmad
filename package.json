{
  "name": "speckit-bmad",
  "version": "0.1.0",
  "description": "SpecKit-BMAD整合项目 - AI驱动的软件开发工作流工具",
  "main": "dist/index.js",
  "bin": {
    "speckit-bmad": "dist/index.js"
  },
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:ui",
    "build:ts": "tsc",
    "build:ui": "pnpm -C ui install --no-frozen-lockfile --ignore-workspace && pnpm -C ui run build && mkdir -p dist/ui && cp -r ui/dist/* dist/ui",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "pretest": "pnpm run build:ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern \"tests/(workflow|integration).*\\.test\\.ts\"",
    "test:integration:json": "jest --testPathPattern \"tests/(workflow|integration).*\\.test\\.ts\" --json --outputFile .bmad/jest-integration.json",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:gate": "eslint src/**/*.ts --max-warnings=0",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepare": "node -e \"process.exit(process.env.CI ? 0 : 1)\" || pnpm run build",
    "benchmark:workflow": "pnpm run build && BMAD_MOCK_LLM=1 node tools/scripts/benchmark-workflow.js --name full-development --runs 3",
    "report:kpi": "node tools/scripts/kpi-report.js",
    "report:integration": "node tools/scripts/integration-pass-rate.js",
    "ci:integration-gate": "node tools/scripts/ci-gate-integration.js",
    "ci:security-gate": "node tools/scripts/ci-gate-security.js",
    "ci:perf-gate": "node tools/scripts/ci-gate-perf.js",
    "ci:cli-smoke-gate": "node tools/scripts/ci-gate-cli-smoke.js",
    "report:artifacts:md": "pnpm run build && node dist/index.js report --format markdown --output docs/最新运行报告.md",
    "report:artifacts:html": "pnpm run build && node dist/index.js report --format html --output docs/最新运行报告.html",
    "report:artifacts": "pnpm run report:artifacts:md && pnpm run report:artifacts:html",
    "example:sprint": "node tools/examples/sprint-planning.js"
  },
  "keywords": [
    "ai",
    "workflow",
    "development",
    "automation",
    "cli",
    "speckit",
    "bmad"
  ],
  "author": "SpecBmad Maintainers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alphabaijinde/SpecBmad.git"
  },
  "bugs": {
    "url": "https://github.com/Alphabaijinde/SpecBmad/issues"
  },
  "homepage": "https://github.com/Alphabaijinde/SpecBmad#readme",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "chalk": "^4.1.2",
    "child_process": "^1.0.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "express": "^5.1.0",
    "fs-extra": "^11.1.1",
    "inquirer": "^9.2.12",
    "mdast-util-to-string": "^4.0.0",
    "module-alias": "^2.2.3",
    "ora": "^7.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "semver": "^7.7.3",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.0.0",
    "winston": "^3.11.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.8",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^24.9.2",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
